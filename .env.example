# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Auto-set by Vercel in production — set manually for local preview/staging
VERCEL_PROJECT_PRODUCTION_URL=

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Seed routes — dev only (disabled in production)
# Run: openssl rand -hex 32
SEED_SECRET=YOUR_SEED_SECRET_HERE
# Default seed admin password — override before running seed
SEED_ADMIN_PASSWORD=YOUR_SEED_ADMIN_PASSWORD_HERE

# Google Analytics 4 Measurement ID — get from analytics.google.com
# One property, add blog stream now, main site stream later (same ID covers both)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Used to run NSFW moderation checks on media uploads via OpenAI's moderation API.
# Required — uploads are blocked when this is unset.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Cloudflare R2 — media storage (S3-compatible)
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=YOUR_R2_ENDPOINT_HERE
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID_HERE
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY_HERE
R2_BUCKET=YOUR_R2_BUCKET_NAME_HERE
# Public URL for serving media (R2 custom domain or r2.dev public URL)
R2_PUBLIC_URL=YOUR_R2_PUBLIC_URL_HERE

# Resend — transactional email
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# Upstash Redis — used for rate limiting and view deduplication
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL_HERE
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN_HERE

# Supabase — consent audit logs
# Public URL (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
# Service role key — server-side only, never expose client-side
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Cloudflare Workers AI — used for AI image generation in admin
# Account ID: dash.cloudflare.com → right sidebar
# API Token: My Profile → API Tokens → Create Token → Workers AI template
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_AI_API_TOKEN_HERE
